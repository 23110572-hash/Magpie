# Copy to backend/.env (local) or set these in the Render dashboard. Never commit real values.

# Neon Postgres - the only database (required)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# LLM brain (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_PROVIDER_SORT=throughput

# Data sources
SERPER_API_KEY=
TAVILY_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GITHUB_TOKEN=

# Accounts: a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Outreach e-mail
# Local: send directly through Gmail (Google account -> Security -> App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Production (Render blocks SMTP): relay through the Vercel function
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=

# Server
PORT=8008
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
